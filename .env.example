# Copie para .env e preencha os segredos antes de iniciar.
AUTHENTICATION_API_KEY=
POSTGRES_DB=evolution
POSTGRES_USER=evolution
# Use uma senha hexadecimal para evitar caracteres reservados na URI.
POSTGRES_PASSWORD=

# Configuração do envio pelo webhook (body: {"message": "Olá"}).
EVOLUTION_INSTANCE_NAME=
# Opcional: usa AUTHENTICATION_API_KEY quando não preenchida.
EVOLUTION_API_KEY=
# Número de destino com país e DDD, somente dígitos.
EVOLUTION_RECIPIENT_NUMBER=
